#!/bin/bash
# Activate project environment

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
cd "$PROJECT_ROOT"

# Load env vars
eval "$(python config/load_env.py)" 2>/dev/null || true

# Handle conda env
CONDA_ENV_PATH=$(python -c "import tomllib; config = tomllib.load(open('config/config.toml', 'rb')); print(config.get('env', {}).get('dir_conda_env', 'null'))")

if [ "$CONDA_ENV_PATH" = "null" ]; then
    ENV_NAME="rst_template6"
    PYTHON_VERSION=$(python -c "import tomllib; config = tomllib.load(open('pyproject.toml', 'rb')); deps = config.get('project', {}).get('requires-python', '>=3.12'); print(deps.split('>=')[1].split('.')[0])")
    conda create -n $ENV_NAME python=$PYTHON_VERSION -y
    conda activate $ENV_NAME
    CONDA_ENV_PATH=$CONDA_PREFIX
    pip install -e . 2>&1 | grep -v "already satisfied"
    echo "Created conda environment at: $CONDA_ENV_PATH. Please update config/config.toml -> dir_conda_env."
else
    if [ ! -d "$CONDA_ENV_PATH" ]; then
        echo "Error: Conda env not found at $CONDA_ENV_PATH" >&2
        exit 1
    fi

    if conda activate "$(basename "$CONDA_ENV_PATH")" 2>/dev/null; then
        # Activation successful, environment was created with -n
        true
    else
        # Activation failed, try with full path (for -p created envs)
        conda activate "$CONDA_ENV_PATH"
    fi
fi